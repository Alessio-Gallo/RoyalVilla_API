﻿@using RoyalVilla.DTO
@model IEnumerable<VillaDTO>

@{
    ViewData["Title"] = "Home";
}

<!-- Hero section -->
<section class="container royal-hero">
    <div class="container royal-hero-content">
        <h1>
            The luxury of feeling<br />
            <span>at home</span>
        </h1>

        <p>
            Discover exclusive villas, extraordinary places, and stays designed for you.
        </p>

        <a href="#ville" class="btn royal-btn">
            Explore villas
            <i class="bi bi-arrow-right"></i>
        </a>
    </div>
</section>

<!-- Elenco dinamico delle ville -->
<section id="ville" class="container royal-villas">
    <div class="royal-section-heading">
        <div>
            <h2>Villas selected for you</h2>
        </div>

        <span class="royal-villa-count">@(Model?.Count() ?? 0) results</span>
    </div>

    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-dismissable fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="royal-empty">
            <h3>No villa available at the moment</h3>
            <p>We're preparing new destinations for you</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var villa in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <article class="villa-card">

                        <div class="villa-card-image">
                            @if (!string.IsNullOrWhiteSpace(villa.ImageUrl))
                            {
                                <img src="@villa.ImageUrl" alt="@villa.Name" loading="lazy" />
                            }
                            else
                            {
                                <img src="https://www.villana.id/images/pvr-villa-placeholder.webp" alt="@villa.Name" loading="lazy"/>
                            }                           
                        </div>

                        <div class="villa-card-body">
                            <div class="villa-card-title">
                                <h3>@villa.Name</h3>
                                <span class="villa-price"> @villa.Rate.ToString("C")</span>
                            </div>

                            <p class="villa-description">@villa.Details</p>

                            <div class="villa-features">
                                <span>
                                    <i class="bi bi-house-door-fill" aria-hidden="true"></i> @villa.Sqft sqft
                                </span>

                                <span>
                                    <i class="bi bi-people-fill" aria-hidden="true"></i> @villa.Occupancy guests
                                </span>
                            </div>

                            <div class="villa-card-footer">
                                <a asp-controller="Villa" asp-action="Details" asp-route-id="@villa.Id" 
                                class="villa-details-link"> Explore <i class="bi bi-arrow-right"></i></a>
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</section>

@if (Model != null){
    <section class="container">
        <div class="row mb-5">
            <div class="col-12">
                <div class="card shadow-lg border-0 rounded-3 stats-card">
                    <div class="card-body p-4">
                        <h3 class="text-center mb-4"> At a Glance</h3>
                        <div class="row text-center g-4">
                            @* Total villas *@
                            <div class="col-md-3">
                                <div class="stat-item">
                                    <i class="bi bi-house-door-fill text-primary fs-1 mb-3"></i>
                                    <h3 class="text-primary fw-bold mb-1">@Model.Count()</h3>
                                    <p class="text-muted mb-0"> Total villas</p>
                                </div>
                            </div>

                            @* Minimum price *@
                            <div class="col-md-3">
                                <div class="stat-item">
                                    <i class="bi bi-cash-coin text-success fs-1 mb-3"></i>
                                    <h3 class="text-success fw-bold mb-1">@Model.Min(v => v.Rate).ToString("C")</h3>
                                    <p class="text-muted mb-0"> Starting From</p>
                                </div>
                            </div>

                            @* Max occupancy *@
                            <div class="col-md-3">
                                <div class="stat-item">
                                    <i class="bi bi-people-fill text-info fs-1 mb-3"></i>
                                    <h3 class="text-info fw-bold mb-1">@Model.Max(v => v.Occupancy).ToString()</h3>
                                    <p class="text-muted mb-0">Max Occupancy</p>
                                </div>
                            </div>

                            @* Max occupancy *@
                            <div class="col-md-3">
                                <div class="stat-item">
                                    <i class="bi bi-arrows-fullscreen text-warning fs-1 mb-3"></i>
                                    <h3 class="text-warning fw-bold mb-1">@Model.Sum(v => v.Sqft).ToString("N0")</h3>
                                    <p class="text-muted mb-0">Total Sqft</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}