@using RoyalVilla.DTO
@model VillaDTO


<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            @* Form card *@
			<div class="card">

                @* Card Header *@
				<div class="card-header bg-danger text-white">
					<span class="fw-semibold h4 pt-1">Delete Villa</span>
				</div>
                
                @* Card body *@
				<div class="card-body">

					<form method="post" enctype="multipart/form-data">
						@* Villa Name *@
						<div class="mb-3">
							<label asp-for="Name" class="form-label">Villa Name</label>
							<input asp-for="Name" disabled class="form-control" placeholder="Enter villa name" />
						</div>

						@* Details *@
						<div class="mb-3">
							<label asp-for="Details" class="form-label">Description</label>
							<textarea disabled asp-for="Details" class="form-control" rows="4"
									  placeholder="Describe the villa"></textarea>
						</div>

						@* Rate and Occupancy*@
						<div class="row">

                            @* Rate *@
							<div class="col-md-6 mb-3">
								<label asp-for="Rate" class="form-label">Nightly Rate</label>
								<div class="input-group">
									<span class="input-group-text">€</span>
									<input asp-for="Rate" disabled type="number" step="0.01" class="form-control" placeholder="0.00" />
								</div>
							</div>

                            @* Occupancy *@
							<div class="col-md-6 mb-3">
								<label asp-for="Occupancy" class="form-label">Max Occupancy</label>
                                <input asp-for="Occupancy" disabled type="number" class="form-control" placeholder="Number of guests" />
							</div>
						</div>

						@* Sqft *@
						<div class="mb-3">
							<label asp-for="Sqft" class="form-label">Square Feet</label>
							<input asp-for="Sqft" disabled type="number" class="form-control" placeholder="Area in sqft" />
						</div>

						<div class="mb-3">
							<label asp-for="ImageUrl" class="form-label">Villa Image</label>
							<input disabled asp-for="ImageUrl" class="form-control" accept="image/*" onchange="previewImage(this)"
								   placeholder="Describe the villa" />
							<small class="form-text text-muted">Supported formats: JPG, JPEG, PNG (Max 5MB)</small>
						</div>

						<div id="imagePreview" class="mt-3" style="display:none">
							<img id="preview" class="img-thumbnail" style="max-width:300px;max-height:300px;" />
						</div>

						@* Action Buttons *@
						<div class="d-flex gap-2 justify-content-end">
							<a asp-action="Index" class="btn btn-light">Cancel</a>
							<button type="submit" class="btn btn-danger">
								<i class="bi bi-check me-2"></i>Delete Villa
							</button>
						</div>
					</form>
				</div>
			</div>
        </div>
    </div>
</div>


